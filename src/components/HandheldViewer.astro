---
import { Image } from 'astro:assets';
import { Box, ArrowLeft, ArrowRight, RotateCcw, Play, X, Pause, Power, ScanLine, Pipette } from '@lucide/astro';
import poster from '../assets/handheld-concept.webp';

interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---

<div class:list={['handheld-viewer', { 'viewer-compact': compact }]} data-handheld-viewer>
  <div class="viewer-scene" data-viewer-scene>
    <Image class="viewer-poster" src={poster} alt="The actual SPS handheld CAD geometry rendered in a proposed purple shell with orange controls and an illustrative SPS screen." width={poster.width} widths={[200, 360, poster.width]} sizes="(max-width: 39rem) 220px, 400px" loading={compact ? 'eager' : 'lazy'} fetchpriority={compact ? 'high' : 'auto'} />
    <canvas class="viewer-canvas" tabindex="0" role="img" aria-label="Interactive SPS handheld model. Arrow keys rotate, Home resets, Escape returns to the static image." hidden></canvas>
  </div>
  <div class="viewer-launch">
    <button class="viewer-load button" type="button" data-viewer-load hidden aria-label={compact ? 'Press start: Explore in 3D' : 'Explore in 3D'}>{compact ? <Power size={18} aria-hidden="true" /> : <Box size={18} aria-hidden="true" />}<span data-viewer-load-label>{compact ? 'Press start' : 'Explore in 3D'}</span></button>
    <p class="viewer-status" role="status" aria-live="polite" data-viewer-status></p>
  </div>
  <div class="viewer-controls" data-viewer-controls hidden>
    <div class="viewer-views" role="group" aria-label="Camera view">
      <button type="button" aria-pressed="true" data-viewer-view="overview">Overview</button>
      <button type="button" aria-pressed="false" data-viewer-view="controls">Controls</button>
      <button type="button" aria-pressed="false" data-viewer-view="profile">Profile</button>
    </div>
    <div class="viewer-tools" role="group" aria-label="Model orientation">
      <button class="icon-button" type="button" data-viewer-left aria-label="Rotate model left" title="Rotate left"><ArrowLeft size={18} aria-hidden="true" /></button>
      <button class="icon-button" type="button" data-viewer-right aria-label="Rotate model right" title="Rotate right"><ArrowRight size={18} aria-hidden="true" /></button>
      <button class="icon-button" type="button" data-viewer-reset aria-label="Reset model view" title="Reset view"><RotateCcw size={18} aria-hidden="true" /></button>
      <button class="icon-button" type="button" data-viewer-replay aria-label="Replay model animation" title="Replay animation"><Play size={18} aria-hidden="true" /></button>
      <button class="icon-button" type="button" data-viewer-stop aria-label="Stop model animation" title="Stop animation" disabled><Pause size={18} aria-hidden="true" /></button>
      <button class="icon-button" type="button" data-viewer-power aria-label="Screen concept power" title="Screen concept power" aria-pressed="false"><Power size={18} aria-hidden="true" /></button>
      <button class="icon-button" type="button" data-viewer-inspect aria-label="Inspect CAD edges" title="Inspect CAD edges" aria-pressed="false"><ScanLine size={18} aria-hidden="true" /></button>
      <button class="icon-button" type="button" data-viewer-close aria-label="Close 3D view" title="Close 3D"><X size={18} aria-hidden="true" /></button>
    </div>
    <div class="viewer-materials" role="group" aria-label="Model materials">
      <button class="material-swatch swatch-concept" type="button" aria-label="Purple and orange colour concept" title="Purple / orange concept" aria-pressed="true" data-viewer-concept></button>
      <button class="material-swatch swatch-original" type="button" aria-label="Source CAD materials" title="Source CAD materials" aria-pressed="false" data-viewer-original></button>
      <label class="viewer-colour-picker" title="Choose shell colour">
        <input type="color" value="#7543b9" aria-label="Shell colour" data-viewer-colour data-selected="false" />
        <Pipette size={20} aria-hidden="true" />
      </label>
      <span data-viewer-material-label>Colour concept</span>
    </div>
    <p class="viewer-concept-note">Screen animation is illustrative, not working firmware.</p>
  </div>
</div>

<script>
  for (const viewer of document.querySelectorAll<HTMLElement>('[data-handheld-viewer]')) {
    const scene = viewer.querySelector<HTMLElement>('[data-viewer-scene]')!;
    const canvas = viewer.querySelector<HTMLCanvasElement>('canvas')!;
    const poster = viewer.querySelector<HTMLImageElement>('.viewer-poster')!;
    const load = viewer.querySelector<HTMLButtonElement>('[data-viewer-load]')!;
    const label = viewer.querySelector<HTMLElement>('[data-viewer-load-label]')!;
    const status = viewer.querySelector<HTMLElement>('[data-viewer-status]')!;
    const controls = viewer.querySelector<HTMLElement>('[data-viewer-controls]')!;
    const concept = viewer.querySelector<HTMLButtonElement>('[data-viewer-concept]')!;
    const original = viewer.querySelector<HTMLButtonElement>('[data-viewer-original]')!;
    const shellColour = viewer.querySelector<HTMLInputElement>('[data-viewer-colour]')!;
    const materialLabel = viewer.querySelector<HTMLElement>('[data-viewer-material-label]')!;
    const power = viewer.querySelector<HTMLButtonElement>('[data-viewer-power]')!;
    const inspection = viewer.querySelector<HTMLButtonElement>('[data-viewer-inspect]')!;
    const stop = viewer.querySelector<HTMLButtonElement>('[data-viewer-stop]')!;
    const viewButtons = viewer.querySelectorAll<HTMLButtonElement>('[data-viewer-view]');
    let instance: Awaited<ReturnType<typeof import('../lib/handheld-viewer').mountHandheld>> | undefined;
    let loading = false;
    const initialLabel = label.textContent;
    const initialAccessibleLabel = load.getAttribute('aria-label')!;
    load.hidden = false;
    const setViewSelection = (name: string) => viewButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.viewerView === name)));

    const applyShellColour = () => {
      instance?.setShellColor(shellColour.value);
      const isDefault = shellColour.value === shellColour.defaultValue;
      concept.setAttribute('aria-pressed', String(isDefault));
      original.setAttribute('aria-pressed', 'false');
      shellColour.dataset.selected = String(!isDefault);
      materialLabel.textContent = 'Colour concept';
      inspection.setAttribute('aria-pressed', 'false');
      viewer.dataset.inspection = 'false';
    };
    const close = () => {
      instance?.dispose();
      instance = undefined;
      canvas.hidden = true;
      controls.hidden = true;
      poster.hidden = false;
      load.hidden = false;
      viewer.dataset.ready = 'false';
      viewer.dataset.inspection = 'false';
      status.textContent = '';
      label.textContent = initialLabel;
      load.setAttribute('aria-label', initialAccessibleLabel);
      load.focus();
    };
    load.addEventListener('click', async () => {
      if (loading) return;
      loading = true;
      load.disabled = true;
      label.textContent = 'Loading model';
      load.setAttribute('aria-label', 'Loading model');
      status.textContent = 'Loading the handheld model.';
      try {
        const { mountHandheld } = await import('../lib/handheld-viewer');
        canvas.hidden = false;
        instance = await mountHandheld(scene, {
          onPlaybackChange: (playing) => {
            stop.disabled = !playing;
            viewer.dataset.playing = String(playing);
          },
          onViewChange: setViewSelection,
        });
        poster.hidden = true;
        load.hidden = true;
        controls.hidden = false;
        viewer.dataset.ready = 'true';
        applyShellColour();
        power.setAttribute('aria-pressed', 'true');
        status.textContent = '';
        instance.intro();
        canvas.focus({ preventScroll: true });
      } catch {
        instance?.dispose();
        canvas.hidden = true;
        poster.hidden = false;
        status.textContent = '3D is unavailable here. The prototype image is still available.';
        label.textContent = 'Retry 3D';
        load.setAttribute('aria-label', 'Retry 3D');
      } finally {
        loading = false;
        load.disabled = false;
      }
    });
    viewer.querySelector('[data-viewer-left]')!.addEventListener('click', () => instance?.rotate(-0.3));
    viewer.querySelector('[data-viewer-right]')!.addEventListener('click', () => instance?.rotate(0.3));
    viewer.querySelector('[data-viewer-reset]')!.addEventListener('click', () => instance?.reset());
    viewer.querySelector('[data-viewer-replay]')!.addEventListener('click', () => {
      instance?.intro();
      power.setAttribute('aria-pressed', 'true');
    });
    stop.addEventListener('click', () => instance?.stop());
    for (const button of viewButtons) button.addEventListener('click', () => {
      instance?.selectView(button.dataset.viewerView as 'overview' | 'controls' | 'profile');
    });
    power.addEventListener('click', () => {
      const active = power.getAttribute('aria-pressed') !== 'true';
      instance?.setPowered(active);
      power.setAttribute('aria-pressed', String(active));
    });
    inspection.addEventListener('click', () => {
      const active = inspection.getAttribute('aria-pressed') !== 'true';
      instance?.setInspection(active);
      inspection.setAttribute('aria-pressed', String(active));
      viewer.dataset.inspection = String(active);
    });
    viewer.querySelector('[data-viewer-close]')!.addEventListener('click', close);
    shellColour.addEventListener('input', applyShellColour);
    shellColour.addEventListener('change', applyShellColour);
    concept.addEventListener('click', () => {
      shellColour.value = shellColour.defaultValue;
      applyShellColour();
    });
    original.addEventListener('click', () => {
      instance?.setConcept(false);
      concept.setAttribute('aria-pressed', 'false');
      original.setAttribute('aria-pressed', 'true');
      shellColour.dataset.selected = 'false';
      materialLabel.textContent = 'Source CAD materials';
    });
    viewer.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && instance) close();
      if (event.target !== canvas || !instance) return;
      const rotations: Record<string, [number, number]> = { ArrowLeft: [-0.2, 0], ArrowRight: [0.2, 0], ArrowUp: [0, -0.15], ArrowDown: [0, 0.15] };
      if (rotations[event.key]) {
        event.preventDefault();
        instance.rotate(...rotations[event.key]);
      } else if (event.key === 'Home') {
        event.preventDefault();
        instance.reset();
      }
    });
    window.addEventListener('pagehide', () => instance?.dispose(), { once: true });
  }
</script>