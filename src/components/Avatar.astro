---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { existsSync } from 'node:fs';
import { getInitials, type Member } from '../data/model';

interface Props { member: Member; }
const { member } = Astro.props;
const portraits = import.meta.glob<{ default: ImageMetadata }>('/public/images/team/*.{webp,png,avif}', { eager: true });
const headshots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/generated/team/*-headshot.png', { eager: true });
const approvedPortrait = member.avatar?.crop
  ? headshots[`/src/assets/generated/team/${member.id}-headshot.png`]?.default
  : member.avatar ? portraits[`/public${member.avatar.src}`]?.default : undefined;
if (member.avatar && !approvedPortrait) throw new Error(`Missing approved portrait for ${member.id}.`);
const reviewPortrait = import.meta.env.DEV && process.env.SPS_REVIEW === '1' && existsSync(new URL(`../../.local/review/portraits/${member.id}-ai.webp`, import.meta.url));
const tones: Record<string, string> = {
  'abdul-waase-qureshi': 'purple',
  'jonart-bajraktari': 'orange',
  'yassin-soliman': 'silver',
  'mujtaba-zia': 'yellow',
  'saifullah-asad': 'deep',
};
---

<div class:list={['portrait', `portrait-${tones[member.id] ?? 'purple'}`, { 'portrait-character': member.avatar || reviewPortrait, 'portrait-headshot': member.avatar?.crop }]}>
  {member.avatar && approvedPortrait ? (
    <Image src={approvedPortrait} alt={member.avatar.alt} width={approvedPortrait.width} height={approvedPortrait.height} widths={[120, 160, 240, 320].filter((width) => width <= approvedPortrait.width)} sizes="(max-width: 39rem) 42vw, 160px" loading="lazy" />
  ) : reviewPortrait ? (
    <>
      <img class="generated-portrait" src={`/__sps-review/portraits/${member.id}-ai.webp`} alt={`AI-generated Mii-style portrait concept for ${member.name}, awaiting member approval.`} width="640" height="768" loading="lazy" />
      <span class="portrait-caption">Concept / awaiting approval</span>
    </>
  ) : (
    <>
      <span class="portrait-initials" aria-hidden="true">{getInitials(member.name)}</span>
      <span class="portrait-caption">Portrait pending</span>
    </>
  )}
</div>