---
import { ArrowUpRight, ChevronRight } from '@lucide/astro';
---

<section class="join-band" aria-labelledby="join-band-title">
  <div class="container join-inner">
    <div>
      <h2 id="join-band-title">The next part is<br />better with you.</h2>
      <p>Bring your curiosity to the team, or help give the project a hand.</p>
    </div>
    <div class="actions">
      <a class="button" href="/join/">Join the team <ChevronRight size={18} aria-hidden="true" /></a>
      <a class="text-link" href="/support/">Support SPS <ArrowUpRight size={17} aria-hidden="true" /></a>
    </div>
  </div>
</section>