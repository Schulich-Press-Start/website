---
import { ArrowUpRight, Plus } from '@lucide/astro';
import Avatar from './Avatar.astro';
import { getRoleLabel, type Member, type Membership, type Division } from '../data/model';

interface Props { member: Member; membership: Membership; division?: Division; }
const { member, membership, division } = Astro.props;
const roleLabel = getRoleLabel(membership, division);
const identifier = `member-${member.id}-${membership.divisionId ?? 'presidency'}`;
---

<details class="member-card" id={identifier} name="sps-roster" data-member>
  <summary aria-label={`${member.name}, ${roleLabel}${member.coFounder ? ' and Co-Founder' : ''}`}>
    <Avatar member={member} />
    <span>
      <span class="member-name">{member.name}</span>
      <span class="member-role">{roleLabel}</span>
      {member.coFounder && <span class="member-founder">Co-Founder</span>}
    </span>
    <Plus size={18} class="member-toggle-icon" aria-hidden="true" />
  </summary>
  <div class="member-details">
    {member.biography && <p>{member.biography}</p>}
    {member.interests.length > 0 && <ul class="interests">{member.interests.map((interest) => <li>{interest}</li>)}</ul>}
    {division && !member.biography && <p>{division.description}</p>}
    <a class="text-link" href={member.linkedin} aria-label={`${member.name} on LinkedIn`}>LinkedIn profile <ArrowUpRight size={16} aria-hidden="true" /></a>
    {member.avatar && <p class="small">Portrait: {member.avatar.credit}</p>}
  </div>
</details>

<script>
  for (const card of document.querySelectorAll<HTMLDetailsElement>('[data-member]')) {
    const summary = card.querySelector('summary');
    const profile = card.querySelector<HTMLAnchorElement>('.member-details a[href]');
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Tab' && card.open) {
        if (!event.shiftKey && event.target === summary && profile) {
          event.preventDefault();
          profile.focus();
        } else if (event.shiftKey && event.target === profile && summary) {
          event.preventDefault();
          summary.focus();
        }
      }
      if (event.key === 'Escape' && card.open) {
        card.open = false;
        summary?.focus();
      }
    });
    card.addEventListener('toggle', () => {
      const url = new URL(window.location.href);
      if (card.open) {
        url.hash = card.id;
        history.replaceState(null, '', url);
      } else if (url.hash === `#${card.id}`) {
        url.hash = '';
        history.replaceState(null, '', url);
      }
    });
  }

  const revealLinkedMember = () => {
    const card = document.getElementById(window.location.hash.slice(1));
    if (card instanceof HTMLDetailsElement && card.hasAttribute('data-member')) card.open = true;
  };
  revealLinkedMember();
  window.addEventListener('hashchange', revealLinkedMember);
</script>