---
import { ArrowUpRight, Plus } from '@lucide/astro';
import { existsSync } from 'node:fs';
import Avatar from './Avatar.astro';
import { getRoleLabel, type Member, type Membership, type Division } from '../data/model';

interface Props { member: Member; membership: Membership; division?: Division; }
const { member, membership, division } = Astro.props;
const roleLabel = getRoleLabel(membership, division);
const identifier = `member-${member.id}-${membership.divisionId ?? 'presidency'}`;
const reviewVideo = import.meta.env.DEV && process.env.SPS_REVIEW === '1'
  && existsSync(new URL(`../../.local/review/portraits/${member.id}-ai.webp`, import.meta.url))
  && existsSync(new URL(`../../.local/review/portraits/${member.id}-ai.mp4`, import.meta.url));
---

<details class="member-card" id={identifier} name="sps-roster" data-member>
  <summary aria-label={`${member.name}, ${roleLabel}${member.coFounder ? ' and Co-Founder' : ''}`}>
    <Avatar member={member} />
    <span class="member-identity">
      <span class="member-name">{member.name}</span>
      <span class="member-role">{membership.role === 'president' ? 'President' : membership.role === 'lead' ? 'Lead' : 'Member'}</span>
      {member.coFounder && <span class="member-founder">Co-Founder</span>}
    </span>
    <Plus size={18} class="member-toggle-icon" aria-hidden="true" />
  </summary>
  <div class="member-details">
    {member.biography && <p>{member.biography}</p>}
    {member.interests.length > 0 && <ul class="interests">{member.interests.map((interest) => <li>{interest}</li>)}</ul>}
    {division && !member.biography && <p>{division.description}</p>}
    <a class="text-link" href={member.linkedin} aria-label={`${member.name} on LinkedIn`}>LinkedIn profile <ArrowUpRight size={16} aria-hidden="true" /></a>
    {reviewVideo && (
      <figure class="portrait-film">
        <video controls muted playsinline preload="none" width="640" height="768" poster={`/__sps-review/portraits/${member.id}-ai.webp`} aria-label={`${member.name} silent character-animation concept`}>
          <source src={`/__sps-review/portraits/${member.id}-ai.mp4`} type="video/mp4" />
        </video>
        <figcaption>Silent animation concept / awaiting member approval.</figcaption>
      </figure>
    )}
  </div>
</details>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pausePortraitVideos = () => document.querySelectorAll<HTMLVideoElement>('.portrait-film video').forEach((video) => video.pause());
  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches) {
      document.querySelectorAll('.portrait').forEach((portrait) => portrait.getAnimations().forEach((animation) => animation.cancel()));
      pausePortraitVideos();
    }
  });
  document.addEventListener('visibilitychange', () => { if (document.hidden) pausePortraitVideos(); });
  for (const card of document.querySelectorAll<HTMLDetailsElement>('[data-member]')) {
    const summary = card.querySelector('summary');
    const profile = card.querySelector<HTMLAnchorElement>('.member-details a[href]');
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Tab' && card.open) {
        if (!event.shiftKey && event.target === summary && profile) {
          event.preventDefault();
          profile.focus();
        } else if (event.shiftKey && event.target === profile && summary) {
          event.preventDefault();
          summary.focus();
        }
      }
      if (event.key === 'Escape' && card.open) {
        card.open = false;
        summary?.focus();
      }
    });
    card.addEventListener('toggle', () => {
      if (!card.open) card.querySelectorAll('video').forEach((video) => video.pause());
      const url = new URL(window.location.href);
      const portrait = card.querySelector<HTMLElement>('.portrait');
      portrait?.getAnimations().forEach((animation) => animation.cancel());
      if (card.open && portrait && !reducedMotion.matches) {
        portrait.animate([
          { transform: 'translateY(0) rotate(0)' },
          { transform: 'translateY(-8px) rotate(-3deg)', offset: 0.4 },
          { transform: 'translateY(0) rotate(0)' },
        ], { duration: 550, easing: 'cubic-bezier(.2,.7,.2,1)' });
      }
      if (card.open) {
        url.hash = card.id;
        history.replaceState(null, '', url);
      } else if (url.hash === `#${card.id}`) {
        url.hash = '';
        history.replaceState(null, '', url);
      }
    });
  }

  const revealLinkedMember = () => {
    const card = document.getElementById(window.location.hash.slice(1));
    if (card instanceof HTMLDetailsElement && card.hasAttribute('data-member')) card.open = true;
  };
  revealLinkedMember();
  window.addEventListener('hashchange', revealLinkedMember);
</script>