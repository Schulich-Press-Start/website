---
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBand from '../components/JoinBand.astro';
import HandheldViewer from '../components/HandheldViewer.astro';
import front from '../../design/reference/prototype1.png';
import angle from '../../design/reference/prototype1-2.png';
---

<BaseLayout title="Handheld" description="Explore SPS's two working handheld prototypes, the next Game Boy-inspired build, custom PCB and firmware work, and future student-chip collaboration.">
  <section class="page-intro">
    <div class="container">
      <span class="status">Two working prototypes</span>
      <h1>The SPS handheld.</h1>
      <p class="lead">Custom PCBs, embedded firmware, games and enclosures.<br />Student-designed handheld systems, built from the ground up.</p>
    </div>
  </section>

  <section class="model-section dark" aria-labelledby="model-title">
    <div class="container">
      <div class="model-heading"><h2 id="model-title">The idea,<br />in your hands.</h2><p>Our actual enclosure model.<br />Purple and orange are a colour concept.</p></div>
      <HandheldViewer />
    </div>
  </section>

  <section class="handheld-stage" id="prototype-views" aria-label="Supplied prototype CAD views">
    <div class="container render-gallery">
      <figure class="cad-view">
        <Image src={front} alt="Front CAD view of the SPS prototype with its rectangular screen, cross D-pad, four round action buttons and two pill buttons." widths={[240, 408]} sizes="(max-width: 39rem) 296px, 334px" loading="eager" fetchpriority="high" quality={90} />
        <figcaption><span>Front view</span><a class="text-link" href={front.src}>Original render <ArrowUpRight size={15} aria-hidden="true" /><span class="sr-only">: front view</span></a></figcaption>
      </figure>
      <figure class="cad-view">
        <Image src={angle} alt="Three-quarter CAD view of the grey SPS enclosure with orange controls and a ground reflection." widths={[300, 487]} sizes="(max-width: 39rem) 294px, 332px" loading="eager" quality={90} />
        <figcaption><span>Three-quarter view</span><a class="text-link" href={angle.src}>Original render <ArrowUpRight size={15} aria-hidden="true" /><span class="sr-only">: three-quarter view</span></a></figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="controls-title">
    <div class="container split-story">
      <h2 id="controls-title">A closer look<br />at the controls.</h2>
      <div>
        <dl class="feature-list">
          <div><dt>Screen area</dt><dd>Rectangular display opening</dd></div>
          <div><dt>Directional input</dt><dd>Cross-shaped D-pad</dd></div>
          <div><dt>Action controls</dt><dd>Four round buttons</dd></div>
          <div><dt>Lower controls</dt><dd>Two pill-shaped buttons</dd></div>
        </dl>
        <p class="feature-note">These are features visible in the supplied enclosure studies, not a final hardware specification.</p>
      </div>
    </div>
  </section>

  <section class="section platform-band dark" id="platform" aria-labelledby="platform-title">
    <div class="container split-story">
      <h2 id="platform-title">Software, with<br />the hardware in mind.</h2>
      <div>
        <p class="lead">Zephyr is our current proposed embedded platform, subject to hardware selection.</p>
        <p>The plan includes firmware, board support, device drivers and stable hardware APIs built around Zephyr RTOS. The final platform and capabilities depend on the hardware we select.</p>
        <a class="text-link" href="/team/#embedded-software">Meet Embedded Software <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="section concept-section" aria-labelledby="concept-title">
    <div class="container split-story">
      <h2 id="concept-title">A little<br />SPS character.</h2>
      <div>
        <p class="lead">Purple shells. Orange and bronze controls.</p>
        <p>A colour direction we're exploring. The CAD renders show the current grey enclosure study; these swatches are proposed colours, not final manufacturing specifications.</p>
        <ul class="colour-concepts">
          <li><span class="colour-swatch colour-purple" aria-hidden="true"></span><span><strong>Purple shell</strong><small>Colour concept</small></span></li>
          <li><span class="colour-swatch colour-orange" aria-hidden="true"></span><span><strong>Orange / bronze controls</strong><small>Colour concept</small></span></li>
        </ul>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="development-title">
    <div class="container split-story">
      <h2 id="development-title">Working hardware.<br />More to build.</h2>
      <div>
        <p class="lead">We have two working prototypes demonstrating different form factors.</p>
        <p>They run games such as Pong, Tomb of the Mask and Brick Breaker. These prototype demos are separate from the original games being developed by SPS.</p>
        <p>Our next focus is a Game Boy-inspired handheld, bringing custom PCB design, embedded firmware and mechanical enclosure design together. Our goal is to complete that handheld by June.</p>
        <a class="text-link" href="/journal/">Visit the build journal <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </section>
  <section class="section platform-band dark" aria-labelledby="collaboration-title">
    <div class="container split-story">
      <h2 id="collaboration-title">Student-designed.<br />Down to the chip.</h2>
      <div>
        <p class="lead">We're collaborating with Schulich on a Chip.</p>
        <p>Members of the fellow club are working on student-designed computer chips intended for a future SPS handheld iteration in the 2027-2028 academic year.</p>
        <p>This is a future integration plan, not a component already in the working prototypes or a specification for the next build.</p>
      </div>
    </div>
  </section>
  <JoinBand />
</BaseLayout>