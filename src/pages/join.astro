---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLink from '../components/ContactLink.astro';
import { club, currentRoster, president, site } from '../data/club';
import { getRosterEntries } from '../data/model';
---

<BaseLayout title="Join" description="Find your place at Schulich Press Start in electronics, embedded software, game design, mechanical design, business or communications.">
  <section class="page-intro">
    <div class="container">
      <h1>Find your part<br />at SPS.</h1>
      <p class="lead">A handheld takes more than one kind of maker. Bring what you're curious about.</p>
      <a class="text-link" href="#applications">{site.recruitmentStatus === 'recruiting' ? 'Joining the team' : 'Application status'} <ArrowUpRight size={17} aria-hidden="true" /></a>
    </div>
  </section>
  <section class="section team-section" aria-label="Explore our divisions">
    <div class="container">
      <nav class="division-jump" aria-label="Explore divisions">{club.divisions.map((division) => <a href={`#${division.id}`}>{division.name}</a>)}</nav>
      <div class="division-descriptions">
        {club.divisions.map((division) => {
          const leads = getRosterEntries(club, currentRoster.id, division.id).filter((entry) => entry.membership.role === 'lead');
          return (
            <section class="division-description" id={division.id} aria-labelledby={`${division.id}-title`}>
              <div>
                <h2 id={`${division.id}-title`}>{division.name}</h2>
                <p>{division.description}</p>
                {leads.length > 0 && <a class="text-link" href={`/team/#${division.id}`}>Led by {leads.map((entry) => entry.member.name).join(', ')} <ArrowUpRight size={16} aria-hidden="true" /></a>}
              </div>
              <ul>{division.work.map((work) => <li>{work}</li>)}</ul>
            </section>
          );
        })}
      </div>
    </div>
  </section>
  <section class="section expectations" aria-labelledby="expectations-title">
    <div class="container split-story">
      <h2 id="expectations-title">Bring curiosity.<br />Build together.</h2>
      <ul class="expectation-list">
        <li><strong>Be ready to learn</strong><p>Tell us what you've tried and what you'd like to explore next.</p></li>
        <li><strong>Make room to contribute</strong><p>Talk with the team about your availability and the work you can take on.</p></li>
        <li><strong>Share your progress</strong><p>Ask questions, document what you discover, and work across disciplines.</p></li>
      </ul>
    </div>
  </section>
  <section class="section application-section" id="applications" aria-labelledby="applications-title">
    <div class="container split-story">
      <div>
        <span class="status" data-application-status>{site.recruitmentStatus === 'recruiting' ? 'Recruiting now' : site.recruitmentStatus === 'paused' ? 'Applications paused' : 'Applications closed'}</span>
        <h2 id="applications-title">Your next project<br />could fit in a pocket.</h2>
        {site.recruitmentStatus === 'recruiting' ? <p>We're interviewing and recruiting new members. Start a conversation about where you'd like to contribute.</p> : <p>Applications aren't being accepted right now. You can still explore the divisions and get in touch with the team.</p>}
        <div class="actions">
          {site.recruitmentStatus === 'recruiting' && site.applicationUrl ? <a class="button" href={site.applicationUrl} data-application-link>Apply to SPS <ArrowUpRight size={18} aria-hidden="true" /></a> : <ContactLink />}
        </div>
      </div>
      <aside class="application-aside">
        <h3>Let's find the right fit.</h3>
        <p>Share the division you're interested in, what you enjoy making, and what you'd like to learn.</p>
        {!site.applicationUrl && !site.publicContact && <p class="contact-note">For the current application process, connect with {president.name}, President and Co-Founder, on LinkedIn.</p>}
      </aside>
    </div>
  </section>
</BaseLayout>