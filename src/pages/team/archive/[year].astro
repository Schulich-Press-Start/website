---
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TeamRoster from '../../../components/TeamRoster.astro';
import { archivedRosters } from '../../../data/club';

export function getStaticPaths() {
  return archivedRosters.map((roster) => ({ params: { year: roster.academicYear }, props: { roster } }));
}

interface Props { roster: (typeof archivedRosters)[number]; }
const { roster } = Astro.props;
---

<BaseLayout title={`Team archive: ${roster.academicYear}`} description={`The Schulich Press Start team for ${roster.academicYear}.`}>
  <section class="page-intro">
    <div class="container">
      <a class="text-link" href="/team/"><ArrowLeft size={17} aria-hidden="true" />Current team</a>
      <h1>The {roster.academicYear} team.</h1>
      <p class="lead">Schulich Press Start team archive.</p>
    </div>
  </section>
  <section class="section team-section" aria-label={`${roster.academicYear} team roster`}>
    <div class="container"><TeamRoster rosterId={roster.id} /></div>
  </section>
</BaseLayout>