---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamRoster from '../../components/TeamRoster.astro';
import JoinBand from '../../components/JoinBand.astro';
import { archivedRosters, currentRoster, site } from '../../data/club';
---

<BaseLayout title="Team" description="Meet the people behind Schulich Press Start: our President and teams in embedded hardware, embedded software, game design, mechanical, business and communications.">
  <section class="page-intro">
    <div class="container page-intro-row">
      <div>
        <h1>The SPS team.</h1>
        <p class="lead">Different disciplines. A shared love of making things you can play.</p>
        {currentRoster.academicYear && <p>{currentRoster.academicYear}</p>}
      </div>
      <div class="page-intro-aside">
        {site.recruitmentStatus === 'recruiting' && <span class="status">Our team is growing</span>}
        <a class="text-link" href="/join/">Find your part <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </section>
  <section class="section team-section" aria-label="Current team roster">
    <div class="container">
      <TeamRoster />
      {archivedRosters.length > 0 && <nav class="archive-links" aria-label="Team archive"><h2>Past teams</h2>{archivedRosters.map((roster) => <a class="text-link" href={`/team/archive/${roster.academicYear}/`}>{roster.academicYear}</a>)}</nav>}
    </div>
  </section>
  <JoinBand />
</BaseLayout>