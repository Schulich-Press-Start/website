{
  "name": "schulich-press-start-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.1.0",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && astro dev --host 127.0.0.1",
    "check": "npm run assets && astro check",
    "build": "npm run assets && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test:unit": "npm run assets && node --test tests/content.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/commissioner": "5.3.0",
    "@fontsource-variable/kufam": "5.3.0",
    "@lucide/astro": "1.46.0",
    "astro": "7.3.2",
    "three": "0.186.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/three": "0.186.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3"
  }
}
